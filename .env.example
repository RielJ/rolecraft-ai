# Copy to .env. Bun loads .env automatically.
DATABASE_URL=postgres://hanapbuhay:hanapbuhay@localhost:5432/hanapbuhay
DATABASE_URL_TEST=postgres://hanapbuhay:hanapbuhay@localhost:5432/hanapbuhay_test
PORT=3000
# Interface to listen on. Keep loopback: the app has no login.
HB_HOST=127.0.0.1
# Extra hostnames (comma-separated, no port) the app answers to besides localhost, 127.0.0.1, [::1].
HB_ALLOWED_HOSTS=
# Path to a Chromium binary for PDF export. Empty uses Playwright's own download.
HB_CHROMIUM_PATH=
# App data directory. The AI key file (mode 0600) is written here.
HB_DATA_DIR=./data
# live (default) calls Anthropic or OpenAI with the key saved in Settings.
# pi runs every AI call through the local pi CLI and its own sign-in (no key stored).
# fake uses the scriptable test provider.
HB_AI=live
# Only read when HB_AI=pi. Thinking: off, minimal, low, medium, high, xhigh, max.
HB_PI_BIN=pi
HB_PI_MODEL_WRITING=claude-opus-5-5
HB_PI_MODEL_LIGHT=claude-haiku-5-5
HB_PI_THINKING_WRITING=low
HB_PI_THINKING_LIGHT=off
