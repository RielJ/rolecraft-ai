{
  "name": "rolecraft",
  "version": "0.1.0",
  "description": "A local-first job search workspace with evidence-backed AI application drafts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "dev:web": "vite",
    "check": "biome check --error-on-warnings . && tsc --noEmit && tsc -p extension/tsconfig.json --noEmit && bun run test && bun run test:budget && bun run test:extension",
    "check:changed": "biome check --error-on-warnings . && tsc --noEmit && tsc -p extension/tsconfig.json --noEmit && bun run test --changed && bun run build && bun scripts/e2e-changed.ts",
    "audit:public": "bun scripts/public-audit.ts",
    "audit:deps": "bun audit --ignore GHSA-67mh-4wv8-2f99",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "build": "vite build",
    "build:extension": "vite build -c vite.extension.config.ts",
    "test": "bun test --parallel=4 --no-isolate",
    "test:budget": "cd test/budget && bun test",
    "test:extension": "bun test --cwd extension",
    "start": "bun src/server/main.ts",
    "app": "bun scripts/app.ts",
    "e2e": "vite build && playwright test",
    "e2e:extension": "tsc -p e2e-extension/tsconfig.json --noEmit && vite build && bun run build:extension && playwright test -c playwright.extension.config.ts",
    "eval": "bun eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@mozilla/readability": "0.6.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "linkedom": "0.18.13",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "openai": "^7.35.0",
    "playwright-core": "^1.64.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/chrome": "0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
